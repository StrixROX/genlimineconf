# Template file for 'genlimineconf'
pkgname=genlimineconf
version=@VERSION@
revision=1
build_style=gnu-makefile
short_desc="Kernel hooks for updating Limine Bootloader config after kernel updates"
maintainer="StrixROX"
license="GPL-3.0-or-later"
homepage="https://github.com/StrixROX/genlimineconf"
changelog="https://github.com/StrixROX/genlimineconf/releases"
hostmakedepends="make"
depends="bash"
distfiles="https://github.com/StrixROX/genlimineconf/archive/refs/tags/v${version}.tar.gz"
checksum="@CHECKSUM@"
conf_files="/etc/genlimineconf/limine.conf.d/options.conf"
