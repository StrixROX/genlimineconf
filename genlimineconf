#!/bin/sh

get_config_path() {
  if [ -f "/boot/limine/limine.conf" ]; then
    echo "/boot/limine"
  elif [ -f "/boot/limine.conf" ]; then
    echo "/boot"
  elif [ -f "/limine/limine.conf" ]; then
    echo "/limine"
  elif [ -f "/limine.conf" ]; then
    echo "/"
  else
    >&2 echo "Error: Missing: limine.conf"
    return 1
  fi
}

get_root_uuid() {
  local ROOTFS_UUID="$(findmnt -n -o UUID /)"

  echo $ROOTFS_UUID
}

init() {
  local DEFAULT_CONFIG_PATH="/boot/limine"

  if ! get_config_path >/dev/null 2>&1; then
    mkdir -p "$DEFAULT_CONFIG_PATH"
    touch "$DEFAULT_CONFIG_PATH/limine.conf"

    echo "Info: Generated blank limine config: $DEFAULT_CONFIG_PATH/limine.conf"
  fi

  local CONF="$(get_config_path)/limine.conf"
  local OPTIONS_CONF="$CONF.parts/options.conf"
  local ENTRIES_PATH="$CONF.parts/entries"

  if [ ! -f "$OPTIONS_CONF" ]; then
    mkdir -p "$CONF.parts"
    touch "$OPTIONS_CONF"

    # default options
    echo "timeout: 5" > "$OPTIONS_CONF"
    echo "default_entry: 2" >> "$OPTIONS_CONF"
    echo "remember_last_entry: yes" >> "$OPTIONS_CONF"
    echo "mouse: no" >> "$OPTIONS_CONF"
    
    echo "Info: Generated blank limine config options: $OPTIONS_CONF"
  fi

  if [ ! -d "$ENTRIES_PATH" ]; then
    mkdir -p "$ENTRIES_PATH"

    echo "Info: Created blank limine boot entries dir: $ENTRIES_PATH"
  fi
}

init_check() {
  check() {
    if ! get_config_path >/dev/null; then
      return 1
    fi

    local CONFIG_PATH="$(get_config_path)"

    local CONF="$CONFIG_PATH/limine.conf"
    local OPTIONS_CONF="$CONF.parts/options.conf"
    local ENTRIES_PATH="$CONF.parts/entries"

    if [ ! -f "$OPTIONS_CONF" ]; then
      >&2 echo "Error: Missing: limine config options: $OPTIONS_CONF"
      return 1uuu
    elif [ ! -d "$ENTRIES_PATH" ]; then
      >&2 echo "Error: Missing: limine boot entries dir: $ENTRIES_PATH"
      return 1
    fi
  }

  if ! check; then
    >&2 echo "Did you run 'genlimineconf init'?"
    exit 1
  fi
}

generate_conf() {
  init_check

  local CONF="$(get_config_path)/limine.conf"
  local ENTRIES_PATH="$CONF.parts/entries"

  echo "Info: Generating limine config: $CONF"

  if ! ls $ENTRIES_PATH/*.entry >/dev/null 2>&1; then
    >&2 echo "Error: Missing: boot entries in: $ENTRIES_PATH"
    exit 1
  fi

  # backup current config
  if [ -f "$CONF" ]; then
    cp $CONF $CONF.bak

    echo "Info: Created backup: $CONF.bak"
  fi

  local ENTRIES_DIR_NAME='Void Linux'

  echo "### This file was generated by genlimineconf" > $CONF
  cat "$CONF.parts/options.conf" >> $CONF
  echo "" >> $CONF
  echo "/+$ENTRIES_DIR_NAME" >> $CONF
  cat $(ls -rdp $ENTRIES_PATH/*.entry) >> $CONF

  echo "Info: Generated limine config: $CONF"
}

generate_boot_entry() {
  if [ -z "$1" ]; then
    >&2 echo "Error: Missing arg: pkgname"
    exit 1
  elif [ -z "$2" ]; then
    >&2 echo "Error: Missing arg: version"
    exit 1
  fi

  local pkgname=$1
  local version=$2
  
  init_check

  local CONFIG_PATH="$(get_config_path)"
  local ENTRIES_PATH="$CONFIG_PATH/limine.conf.parts/entries"

  if [ ! -d "$ENTRIES_PATH" ]; then
    mkdir -p "$ENTRIES_PATH"
  fi

  local ENTRY="${ENTRIES_PATH}/${pkgname}_${version}.entry"
  local ROOT_UUID=$(get_root_uuid)

  echo "  //$pkgname $version" > $ENTRY
  echo "  ### This entry was generated by genlimineconf" >> $ENTRY
  echo "  comment: Kernel version: $version" >> $ENTRY
  echo "  comment: kernel-id: $pkgname" >> $ENTRY
  echo "  protocol: linux" >> $ENTRY
  echo "  path: boot():/vmlinuz-$version" >> $ENTRY
  echo "  module_path: boot():/initramfs-$version.img" >> $ENTRY
  echo "  cmdline: quiet rw root=UUID=$ROOT_UUID" >> $ENTRY
  echo "" >> $ENTRY

  echo "Info: Generated limine boot entry: $ENTRY"
}

remove_boot_entry() {
  if [ -z "$1" ]; then
    echo "Error: Missing arg: pkgname"
    exit 1
  elif [ -z "$2" ]; then
    echo "Error: Missing arg: version"
    exit 1
  fi

  local pkgname=$1
  local version=$2

  init_check

  local CONFIG_PATH="$(get_config_path)"
  local ENTRIES_PATH="$CONFIG_PATH/limine.conf.parts/entries"
  local ENTRY="${ENTRIES_PATH}/${pkgname}_${version}.entry"

  if [ ! -d "$ENTRIES_PATH" ]; then
    echo "Error: Missing: $ENTRIES_PATH"
    exit 1
  elif [ ! -f "$ENTRY" ]; then
    echo "Error: Boot entry not found: $ENTRY"
  fi

  rm $ENTRY

  echo "Info: Removed boot entry: $ENTRY"
}

case $1 in
  add-entry)
    generate_boot_entry linux $3
    ;;
  remove-entry)
    remove_boot_entry linux $3
    ;;
  init)
    init
    ;;
  *)
    generate_conf
    ;;
esac
